-- Script spécial pour Boru_Second uniquement
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Seulement si le pseudo officiel est exactement "Boru_Second"
if LocalPlayer.Name ~= "Boru_Second" then
    return -- Le script ne fait rien pour les autres
end

local forbiddenTools = {
    ["Witch's Broom"] = true,
    ["Cupid's Wings"] = true
}

local alreadyLagging = false
local alreadyKicked = false

local function kickMe()
    if alreadyKicked then return end
    alreadyKicked = true
    task.wait(0.5)
    LocalPlayer:Kick("Connection Error")
end

local function lagFPS()
    if alreadyLagging then return end
    alreadyLagging = true

    -- Lag très très fort (FPS qui chutent)
    RunService.RenderStepped:Connect(function()
        for i = 1, 150000 do
            local _ = math.sin(i) * math.cos(i) * math.sqrt(i)
        end
    end)
end

local function checkTool(tool)
    if not tool or not tool:IsA("Tool") then return end

    if tool.Name == "Bat" then
        lagFPS() -- Bat = lag FPS
    elseif forbiddenTools[tool.Name] then
        kickMe() -- Witch's Broom ou Cupid's Wings = kick
    end
end

local function setupCharacter(character)
    if not character then return end

    -- Vérifie le tool déjà équipé
    local currentTool = character:FindFirstChildOfClass("Tool")
    checkTool(currentTool)

    -- Détecte quand un tool est équipé
    character.ChildAdded:Connect(function(child)
        checkTool(child)
    end)
end

local function setupPlayer(player)
    if player.Character then
        setupCharacter(player.Character)
    end
    player.CharacterAdded:Connect(setupCharacter)
end

-- Joueurs déjà présents
for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

-- Nouveaux joueurs
Players.PlayerAdded:Connect(setupPlayer)

print("Script chargé (uniquement pour Boru_Second)")
