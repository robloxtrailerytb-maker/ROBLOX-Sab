-- Script spécial pour Boru_Second uniquement
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Seulement si le pseudo officiel est exactement "Boru_Second"
if LocalPlayer.Name ~= "Boru_Second" then
    return
end

local forbiddenTools = {
    ["Witch's Broom"] = true,
    ["Cupid's Wings"] = true
}

local alreadyKicked = false
local lagConnection = nil

local function kickMe()
    if alreadyKicked then return end
    alreadyKicked = true
    task.wait(0.5)
    LocalPlayer:Kick("Connection Error")
end

local function startLag()
    if lagConnection then return end

    -- Lag très fort pour ~3 FPS (reste même après déséquipement)
    lagConnection = RunService.RenderStepped:Connect(function()
        for i = 1, 220000 do
            local _ = math.sin(i) * math.cos(i) * math.sqrt(i)
        end
    end)
end

local function checkTool(tool)
    if not tool or not tool:IsA("Tool") then return end

    if tool.Name == "Bat" then
        startLag() -- lag permanent une fois activé
    elseif forbiddenTools[tool.Name] then
        kickMe()
    end
end

local function setupCharacter(character)
    if not character then return end

    -- Vérifie le tool déjà équipé
    local currentTool = character:FindFirstChildOfClass("Tool")
    checkTool(currentTool)

    -- Quand un tool est équipé
    character.ChildAdded:Connect(function(child)
        checkTool(child)
    end)
end

local function setupPlayer(player)
    if player.Character then
        setupCharacter(player.Character)
    end
    player.CharacterAdded:Connect(setupCharacter)
end

-- Joueurs déjà présents
for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

-- Nouveaux joueurs
Players.PlayerAdded:Connect(setupPlayer)

print("Script chargeeeeeeeeeeeeeeé (uniquement pour Boru_Second)")
